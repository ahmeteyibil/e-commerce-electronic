<div class="product-box max-w-md p-2 bg-red-100 rounded-xl shadow-md border border-black-100 text-center flex flex-col">
        <div class="product-visual  ">
            <a href="#"><img src="/images/product_image_example.jpg" alt="Example Product Image" class="w-32 h-32"></a>
        </div>
        <div class="product-content flex flex-col gap-y-1 text-left">
            <h5 class="mb-6 hover:text-blue-700 font-bold transition-all duration-200"><a href="#"><%= product.name %></a></h5>
            <h3>Stok Kodu: <%= product.stokCode %></h3>
            <h3><%= product.price %>₺</h3>
        </div>
