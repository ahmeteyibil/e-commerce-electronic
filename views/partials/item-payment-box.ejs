<div id="item-payment-box" class="h-40 w-30 rounded-sm bg-blue-500 p-1">
    <a href="/product/<%- product.id %>" class="h-full flex flex-col">
        <img src="<%- product.image_url %>" alt="image" class="w-full h-30 object-cover aspect-square">
        <span class="p-1 font-bold bg-blue-300"><%= product.price %> TL</span>
    </a>
</div>