<header class="w-full h-20 bg-blue-400 flex items-center justify-center">
        <div class="container w-3/4 h-full flex justify-between items-center">
            <ul class="header-navbar flex gap-x-6 justify-center items-center font-semibold">
                <li><a href="/">Ana Sayfa</a></li>
                <li><a href="/product-trends">Trend Ürünler</a></li>
                <li class="cursor-pointer ">
                    <div class="group relative">
                        <div>Kategoriler <i class="fa-solid fa-caret-down"></i></div>
                        <div class="absolute left-0 mt-1 w-48 bg-[#50A2FF] border border-gray-100 rounded-lg shadow-lg py-1 
                        opacity-0 invisible group-hover:opacity-100 group-hover:visible 
                        transition-all duration-200 ease-in-out z-50">
                            <a href="/category/electronics"
                                class="block px-4 py-2 text-sm text-gray-700 hover:bg-blue-600">Elektronik</a>
                            <a href="/category/home-and-living"
                                class="block px-4 py-2 text-sm text-gray-700 hover:bg-blue-600">Ev ve Yaşam</a>
                        </div>
                </div></li>
            </ul>
            <div class="header-content flex gap-x-4 items-center">
                <a href="/cart" class="relative">
                    <i class="fa-solid fa-bag-shopping text-2xl -z-10"></i> 
                    <div class="absolute -bottom-2 -right-2 border border-blue-500 border-solid bg-blue-700 text-white rounded-full p-1 w-5 h-5 flex justify-center items-center text-[0.8rem]">
                        <span id="cart-count"><%= cartItemCount %></span>
                    </div>
                </a>
                <% if(user) { %>
                    <div class="relative group">
                        <div
                            class="user-box bg-blue-700 px-4 py-2 flex justify-between items-center gap-x-4 text-white hover:bg-blue-500 cursor-pointer transition-all duration-200">
                            <!-- <i class="fa-solid fa-user"></i> -->
                            <%= user.name %>
                                <i class="fa-solid fa-caret-down"></i>
                        </div>
                        <div class="absolute right-0 mt-1 w-48 bg-white border border-gray-100 rounded-lg shadow-lg py-1 
                        opacity-0 invisible group-hover:opacity-100 group-hover:visible 
                        transition-all duration-200 ease-in-out z-50">
                            <a href="/profile"
                                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Profilim</a>
                            <a href="/orders"
                                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Siparişlerim</a>
                            <% if(user.role != "seller"){ %>
                                <a href="/become-a-seller" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                                    Satıcı ol
                                </a>
                                <% } %>
                                <div class="border-t border-gray-100 my-1"></div>
                            <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">Çıkış
                                Yap</a>
                        </div>
                    </div>
                    <% }else{ %>
                        <a href="/login">
                            <button
                                class="btn-login px-6 py-2 text-bold bg-blue-600 text-white text-center cursor-pointer hover:bg-blue-700 transtiion-all duration-300">
                                Giriş Yap
                            </button>
                        </a>
                        <% } %>
            </div>
        </div>
    </header>