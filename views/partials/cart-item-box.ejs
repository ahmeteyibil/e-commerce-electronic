<div class="cart-item-box py-2 px-4 rounded-xl shadow-md border-2 border-red-300 text-center flex justify-between items-center w-240 relative">

    <div class="cart-item-content px-2 flex gap-x-4">
        <div class="cart-item-visual border-solid border-black">
            <a href="product/<%= ciBoxData.product.id %>"><img src="<%= ciBoxData.product.image_url %>" alt="Example Product Image" class="w-20 h-20"></a>
        </div>
        <div class="flex flex-col justify-between items-start gap-y-1 text-left  border-solid border-black ">
            <h5 class="mb-2 hover:text-blue-700 font-bold transition-all duration-200 text-lg"><a href="product/<%= ciBoxData.product.id %>">
                    <%= ciBoxData.product.name %>
                </a>
            </h5>
            <h3>Stok Kodu: <%= ciBoxData.product.stock_code %>
            </h3>
            <h3>
                <%= ciBoxData.product.description %>
            </h3>
        </div>

    </div>
    <div class="dinamic-area flex justify-between items-center flex-1 max-w-100">
        <div
            class="quantity-area border border-solid border-black flex flex-col justify-center items-center gap-y-1 p-2 rounded-xl">
            <div>
                <span class="quantity-value font-bold text-lg">
                    <%= ciBoxData.cart_item.quantity %>
                </span>
            </div>
            <div class="change-quantity-area flex justify-between items-center gap-x-4 ">
                <button
                    class="quantity-change-btn increase-btn w-6 h-6 bg-green-600 text-md text-white cursor-pointer transition-all duration-200 hover:bg-green-700"
                    data-cart-item-id="<%= ciBoxData.cart_item.id %>" data-product-id="<%= ciBoxData.product.id %>"><i
                        class="fa-solid fa-plus"></i>
                    </button>
                <button
                    class="quantity-change-btn decrease-btn w-6 h-6 bg-red-600 text-md text-white cursor-pointer transition-all duration-200 hover:bg-red-700"
                    data-cart-item-id="<%= ciBoxData.cart_item.id %>" data-product-id="<%= ciBoxData.product.id %>"><i
                        class="fa-solid fa-minus"></i>
                </button>
            </div>
        </div>
        <h3 class="italic text-lg font-bold">
            <span class="cost-value"><%= ciBoxData.product.price * ciBoxData.cart_item.quantity %></span>₺
        </h3>
    </div>
    <button class="remove-item-btn absolute right-2 bottom-2 bg-red-600 cursor-pointer p-1 text-xs font-bold text-blac" data-cart-item-id="<%= ciBoxData.cart_item.id %>">
        <i class="fa-solid fa-trash"></i> Sil
    </button>
</div>