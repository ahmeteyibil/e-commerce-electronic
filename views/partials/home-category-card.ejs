<a href="/category/<%= category.slug %>"
    class="group flex items-center justify-between rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-blue-100/60">
    <div class="flex items-center gap-5">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-xl text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white">
            <i class="<%= category.icon_class %>"></i>
        </div>
        <div>
            <h3 class="text-xl font-bold text-slate-900"><%= category.name %></h3>
            <p class="mt-1 max-w-xs text-sm leading-6 text-slate-500"><%= category.description %></p>
        </div>
    </div>
    <i class="fa-solid fa-arrow-right text-slate-300 transition group-hover:translate-x-1 group-hover:text-blue-600"></i>
</a>