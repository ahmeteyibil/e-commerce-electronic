<div id="product-my-shop-box"
    class="w-48 group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-300 flex flex-col h-64">

    <!-- Ürün Görseli Alanı -->
    <div class="relative overflow-hidden aspect-square bg-gray-100 flex items-center justify-center p-2 h-36">
        <a href="/product/<%= product.id %>" class="block w-full h-full">
            <img src="<%= product.primary_image_url %>" alt="<%= product.name %>"
                class="w-full h-full object-cover rounded-xl transition-transform duration-500"
                id="product-img">
        </a>
    </div>

    <!-- Ürün İçeriği -->
    <div class="px-4 py-2 flex flex-col text-left">
        <!-- Stok Kodu (Daha kibar ve soluk) -->
        <span class="text-[.6rem] font-semibold text-gray-400 mb-1 tracking-wider uppercase">
            Stok: <%= product.stock_code %>
        </span>

        <!-- Ürün Adı -->
        <h5 class="text-lg font-bold text-gray-800 leading-tight mb-1 grow">
            <a href="/product/<%= product.id %>" class="hover:text-indigo-600 transition-colors duration-200 text-md">
                <span id="product-name">
                    <%= product.name %>
                </span>
            </a>
        </h5>

    </div>
    <div class="flex items-center px-4">
        <button id="edit-product-btn"
            class="edit-product-btn bg-amber-500 hover:bg-amber-600 text-white px-2 py-1 rounded-lg transition-all duration-200 cursor-pointer w-32"
            data-product-id="<%= product.id %>">
            Ürünü Düzenle
        </button>
    </div>

</div>