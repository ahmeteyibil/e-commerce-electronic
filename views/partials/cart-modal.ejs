<!-- Varsayılan olarak 'hidden' (gizli) class'ı ile duruyor -->
<div id="cart-success-modal" class="hidden fixed inset-0 z-50 overflow-y-auto opacity-0">
    <!-- Arka plan karartması -->
    <div class="fixed inset-0 bg-black opacity-50 transition-opacity"></div>

    <!-- Ortalanmış Pop-up Kutusu -->
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
        <div class="relative bg-white rounded-lg px-4 pt-5 pb-4 overflow-hidden shadow-xl transform transition-all sm:my-8 sm:max-w-md sm:w-full sm:p-6 z-10 flex flex-col items-center justify-center gap-y-8 min-w-160">
            <div id="cart-modal-header" class="flex justify-center items-center gap-x-6 text-green-600">
                <div class="rounded-full p-2 text-2xl border border-solid border-black">
                    <i class="fa-solid fa-check"></i>
                </div>
                <span class="text-2xl font-bold">
                    Ürün sepete eklendi.
                </span>
            </div>
            <div id="item-infos" class="flex justify-between items-center gap-x-4 w-full p-4 border-4 border-solid border-blue-500 rounded-xl">
                        <div class="item-visual border border-solid border-gray-400 rounded-xl h-28 w-28">
                    <img src="w-full h-full" alt="product-image" id="added-product-image" class="w-full h-full rounded-xl">
                </div>
                <div class="item-content flex-1 flex flex-col justify-start items-start">
                    <div>
                        <span id="added-product-name">
                        </span>    
                    </div>
                    
                    <div class="flex justify-start items-center text-xs">
                        <span>Satıcı: </span>
                        <span id="seller-name">
                        </span>
                    </div>
                </div>
                <div id="buttons" class="flex flex-col gap-y-4 items-center justify-center">
                    <button id="go-to-cart-btn" class="px-4 py-2 font-bold rounded-xl outline-none bg-blue-600  cursor-pointer text-white">
                        <a href="/cart">Sepete git</a>
                    </button>
                    <button id="continue-shopping-btn" class="px-4 py-2 font-bold rounded-xl outline-none bg-orange-100 text-blue-600 cursor-pointer">
                        Alışverişe devam et.
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>