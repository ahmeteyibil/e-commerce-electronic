<div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 transition hover:-translate-y-1 hover:shadow-md">
    <div class="flex h-11 w-11 items-center justify-center rounded-xl <%= item.color %>">
        <i class="<%= item.icon %> text-lg"></i>
    </div>
    <p class="mt-4 font-bold text-slate-900"><%= item.name %></p>
    <p class="mt-1 text-xs leading-5 text-slate-500"><%= item.detail %></p>
</div>