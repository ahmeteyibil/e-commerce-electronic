<div id="product-box" class="max-w-md p-4 bg-red-100 rounded-xl shadow-md border border-black-100 text-center flex flex-col">
    <div class="product-visual  ">
        <a href="/product/<%= product.id %>"><img src="<%= product.image_url %>" alt="Example Product Image" class="w-32 h-32" id="product-img"></a>
    </div>
    <div class="product-content flex flex-col gap-y-1 text-left">
        <h5 class="mb-2 hover:text-blue-700 font-bold transition-all duration-200"><a href="product/<%= product.id %>">
                <span id="product-name">
                    <%= product.name %>
                </span>
            </a></h5>
        <h3>Stok Kodu: <%= product.stock_code %>
        </h3>
        <h3 class="italic">
            <span id="product-price" class="font-bold text-lg">
                <%= product.price %>₺
            </span>
        </h3>
    </div>
    <button id="add-to-cart-btn" class="mt-2 add-to-bucket bg-blue-700 hover:bg-blue-900 text-white px-4 py-2 text-md cursor-pointer rounded-lg transition-all duration-200"
        data-product-id="<%= product.id %>">
        Sepete Ekle
    </button>
</div>