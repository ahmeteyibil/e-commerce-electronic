<div class="flex justify-center items-center flex-col gap-y-4">
    <div class="profile-header">
        <h1 class="text-4xl capitalize font-bold">Profile</h1>
    </div>
    <div class="profile-content p-4 flex justify-center items-center flex-col gap-y-4 border-4 border-solid border-black rounded-xl">
        <div class="info-box flex justify-between items-center">
            <span>İsim: <%= user.name %></span>
        </div>
        <div class="info-box">Email: <%= user.email %>
        </div>
        <div class="info-box">Hesap oluşturulma tarihi: <%= user.createdAt %>
        </div>
    </div>
</div>