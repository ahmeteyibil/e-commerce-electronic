<main class="w-full">
    <section
        class="mx-auto grid min-h-[calc(100vh-5rem)] max-w-6xl items-center gap-12 px-6 py-16 lg:grid-cols-[1.1fr_.9fr] lg:px-10">
        <div class="max-w-xl">
            <span
                class="mb-5 inline-flex items-center gap-2 rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-800">
                <i class="fa-solid fa-sparkles"></i>
                Sade alışveriş, iyi seçimler
            </span>
            <h1 class="max-w-2xl text-5xl font-bold leading-tight tracking-tight text-slate-900 sm:text-6xl">
                İhtiyacın olanı,
                <span class="text-blue-600">kolayca bul.</span>
            </h1>
            <p class="mt-6 max-w-lg text-lg leading-8 text-slate-600">
                Simmar, elektronik ve günlük yaşam ürünlerini sade bir deneyimle keşfetmen için tasarlanmış bir pazar
                yeri.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
                <a href="/trend-products"
                    class="rounded-xl bg-blue-600 px-6 py-3 font-semibold text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700">
                    Ürünleri keşfet
                </a>
                <a href="#categories"
                    class="rounded-xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-700">
                    Kategorilere göz at
                </a>
            </div>
            <div class="mt-10 flex items-center gap-6 text-sm text-slate-500">
                <span><i class="fa-solid fa-check mr-2 text-blue-600"></i>Kolay kullanım</span>
                <span><i class="fa-solid fa-check mr-2 text-blue-600"></i>Güvenli sepet</span>
            </div>
        </div>
        <div class="relative mx-auto w-full max-w-md">
            <div class="absolute -left-8 top-12 h-32 w-32 rounded-full bg-blue-200/70 blur-3xl"></div>
            <div class="absolute -right-8 bottom-0 h-40 w-40 rounded-full bg-cyan-200/70 blur-3xl"></div>
            <div
                class="relative overflow-hidden rounded-4xl border border-white bg-white p-5 shadow-2xl shadow-slate-300/70">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Simmar seçkisi</p>
                        <p class="mt-1 text-xl font-bold text-slate-900">Bugünün favorileri</p>
                    </div>
                    <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">Yeni</span>
                </div>
                <div class="mt-5 grid grid-cols-2 gap-4">
                    <!-- Tekrarlanan ürün kartı içeriği partials/home-showcase-item.ejs içindedir. -->
                    <%- include('../partials/home-showcase-item', { item: { name: 'Teknoloji' ,
                        detail: 'Günlük kullanım için' , icon: 'fa-solid fa-headphones' ,
                        color: 'bg-blue-100 text-blue-700' } }) %>
                        <%- include('../partials/home-showcase-item', { item: { name: 'Yaşam' ,
                            detail: 'Alanına uyum sağlayan' , icon: 'fa-solid fa-lightbulb' ,
                            color: 'bg-amber-100 text-amber-700' } }) %>
                            <%- include('../partials/home-showcase-item', { item: { name: 'Pratik' ,
                                detail: 'İşini kolaylaştıran' , icon: 'fa-solid fa-wand-magic-sparkles' ,
                                color: 'bg-emerald-100 text-emerald-700' } }) %>
                                <%- include('../partials/home-showcase-item', { item: { name: 'Seçili' ,
                                    detail: 'İhtiyacına göre' , icon: 'fa-solid fa-heart' ,
                                    color: 'bg-rose-100 text-rose-700' } }) %>
                </div>
                <div class="mt-5 flex items-center justify-between rounded-2xl bg-slate-900 px-5 py-4 text-white">
                    <div>
                        <p class="text-sm font-semibold">Alışverişe hazır mısın?</p>
                        <p class="mt-1 text-xs text-slate-300">Sade deneyimi şimdi keşfet.</p>
                    </div>
                    <i class="fa-solid fa-arrow-right text-blue-300"></i>
                </div>
            </div>
        </div>
    </section>
    <section id="categories" class="mx-auto max-w-6xl scroll-mt-8 px-6 py-16 lg:px-10">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-600">Keşfet</p>
                <h2 class="mt-2 text-3xl font-bold text-slate-900">Neye ihtiyacın var?</h2>
            </div>
            <a href="/trend-products" class="font-semibold text-slate-600 transition hover:text-blue-700">
                Tüm ürünleri gör <i class="fa-solid fa-arrow-right ml-2"></i>
            </a>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
            <!-- Tekrarlanan kategori kartı içeriği partials/home-category-card.ejs içindedir. -->
            <% if(typeof(homeCategories) !== "undefined" && homeCategories) { %>
                <% homeCategories.forEach(category => { %>
                    <%- include('../partials/home-category-card', { category: category }) %>
                        <% }); %>
                            <% } %>
        </div>
    </section>
    <section class="border-y border-slate-200 bg-white/70">
        <div class="mx-auto max-w-6xl px-6 py-16 lg:px-10">
            <div class="mb-8">
                <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-600">Neden Simmar?</p>
                <h2 class="mt-2 text-3xl font-bold text-slate-900">Alışverişi zorlaştırmıyoruz.</h2>
            </div>
            <div class="grid gap-5 md:grid-cols-3">
                <!-- Tekrarlanan değer önerisi içeriği partials/home-feature-card.ejs içindedir. -->
                <% homeFeatures.forEach(feature=> { %>
                    <%- include('../partials/home-feature-card', { feature: feature }) %>
                        <% }); %>
            </div>
        </div>
    </section>
    <% if (homeProducts.length> 0) { %>
        <section class="mx-auto max-w-6xl px-6 py-16 lg:px-10">
            <div class="mb-8 flex items-end justify-between gap-4">
                <div>
                    <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-600">Senin için seçtik</p>
                    <h2 class="mt-2 text-3xl font-bold text-slate-900">Öne çıkan ürünler</h2>
                </div>
                <a href="/trend-products" class="font-semibold text-slate-600 transition hover:text-blue-700">
                    Tümünü gör <i class="fa-solid fa-arrow-right ml-2"></i>
                </a>
            </div>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                <!-- Tekrarlanan ürün kartı içeriği mevcut partials/product-box.ejs içindedir. -->
                <% homeProducts.forEach(product=> { %>
                    <%- include('../partials/product-box', { product: product }) %>
                        <% }); %>
            </div>
        </section>
        <% } %>
            <section class="mx-auto max-w-6xl px-6 pb-20 pt-4 lg:px-10">
                <div
                    class="flex flex-col items-start justify-between gap-6 rounded-3xl bg-blue-600 px-8 py-10 text-white shadow-xl shadow-blue-200 sm:flex-row sm:items-center sm:px-12">
                    <div>
                        <p class="text-2xl font-bold">Sade alışverişe ilk adımı at.</p>
                        <p class="mt-2 text-blue-100">İhtiyacın olan ürünleri keşfetmeye hemen başla.</p>
                    </div>
                    <a href="/trend-products"
                        class="shrink-0 rounded-xl bg-white px-6 py-3 font-bold text-blue-700 transition hover:bg-blue-50">
                        Alışverişe başla
                    </a>
                </div>
            </section>
</main>