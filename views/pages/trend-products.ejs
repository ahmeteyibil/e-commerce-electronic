<div class="flex flex-col gap-y-4 items-center justify-center my-8 relative">
    <h1 class="text-4xl capitalize font-bold">Revaçtaki ürünler</h1>
    <div class="products flex gap-x-4 items-center justify-center border border-black p-4">
        <% if (products.length> 0) { %>
            <% products.forEach(product=> {%>
                <%- include('../partials/product-box', { product: product }) %>
                    <% }); %>
                        <% } %>
    </div>

</div>

<script src="/js/product-box.js"></script>
<script>
    
    // Sayfadaki HERHANGİ bir tıklamayı dinliyoruz
    document.addEventListener('click', async (e) => {

        if (e.target.id == "in-cart-btn") {
            window.location.href = "/cart";
            return;
        }

        // Tıklanan öğe veya onun ebeveyni 'add-to-cart-btn' sınıfına sahip mi bakıyoruz
        const addToCartBtn = e.target.closest('#add-to-cart-btn');


        const productBox = e.target.closest('#product-box');
        // Eğer tıklanan şey sepete ekle butonuysa işlemi başlat
        if (addToCartBtn) {
            const productName = productBox?.querySelector("#product-name").textContent;
            const productImg = productBox?.querySelector("#product-img").src;

            const productId = addToCartBtn.dataset.productId;
            console.log("Frontend'den gönderilecek ID:", productId); // BUNA BAK
            try {
                const response = await fetch('/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: productId, quantity: 1 })
                });

                const data = await response.json();

                if (data.success) {
                    // Header'daki sepet sayacını güncelliyoruz
                    const cartCounter = document.getElementById('cart-count');
                    if (cartCounter) {
                        cartCounter.innerText = data.cartCount;
                    }
                    // Butonun arka planı yeşil olur ve texti "sepette" olur. Buton id'si değişir ve tıklanıldığında 
                    // sepete yönlendirir.
                    convertToInCartButton(addToCartBtn);
                    // .5 saniye sonra
                    setTimeout(() => {
                        // Cart Modal'ı görünür yap.
                        const currentlyOpen = !cartModal.classList.contains("hidden");
                        const openIt = !currentlyOpen;
                        toggleCartModal(openIt, productName, productImg);
                    }, 500)
                }
            } catch (err) {
                console.error("Sepete ekleme hatası:", err);
            }
        }
    });
</script>