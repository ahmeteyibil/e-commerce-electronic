<div class="max-w-6xl mx-auto p-6">
    <!-- Üst Başlık ve Butonlar -->
    <div class="flex items-center justify-between pb-6 border-b border-gray-200 mb-6">
        <div>
            <a href="/my-shop" class="text-sm text-gray-500 hover:text-gray-700">← Ürünlere Dön</a>
            <h1 class="text-2xl font-bold text-gray-900 mt-1">Ürünü Düzenle: <%= product.name %></h1>
        </div>
        <div class="flex gap-3">
            <a href="/product/<%= product.id %>" target="_blank" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium hover:bg-gray-50">Sitede Gör</a>
            <button form="edit-product-form" type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium shadow-sm">Değişiklikleri Kaydet</button>
        </div>
    </div>

    <!-- Form Alanı (2 Sütunlu Grid) -->
    <form id="edit-product-form" action="/admin/products/<%= product.id %>/edit" method="POST" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Sol Sütun (Ana İçerik) -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- Genel Bilgiler Kartı -->
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm space-y-4">
                <h2 class="text-base font-semibold text-gray-900">Temel Bilgiler</h2>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Ürün Adı</label>
                    <input type="text" name="name" value="<%= product.name %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Açıklama</label>
                    <textarea name="description" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm"><%= product.description %></textarea>
                </div>
            </div>

            <!-- Medya Kartı -->
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm space-y-4">
                <h2 class="text-base font-semibold text-gray-900">Görsel</h2>
                <div class="flex items-center gap-4">
                    <img src="<%= product.image_url %>" alt="Mevcut Görsel" class="w-20 h-20 object-cover rounded-lg border border-gray-200">
                    <div class="flex-grow">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Görsel URL</label>
                        <input type="text" name="imageUrl" value="<%= product.image_url %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm">
                    </div>
                </div>
            </div>

            <!-- Fiyatlandırma Kartı -->
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm space-y-4">
                <h2 class="text-base font-semibold text-gray-900">Fiyat ve Stok</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Fiyat (₺)</label>
                        <input type="number" step="0.01" name="price" value="<%= product.price %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Stok Kodu (SKU)</label>
                        <input type="text" name="stockCode" value="<%= product.stock_code %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm">
                    </div>
                </div>
            </div>

        </div>

        <!-- Sağ Sütun (Meta ve Organizasyon) -->
        <div class="space-y-6">
            
            <!-- Durum Kartı -->
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm space-y-3">
                <h2 class="text-base font-semibold text-gray-900">Ürün Durumu</h2>
                <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm">
                    <option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Aktif (Yayında)</option>
                    <option value="draft" <%= product.status === 'draft' ? 'selected' : '' %>>Taslak</option>
                </select>
            </div>

            <!-- Kategori Kartı -->
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm space-y-3">
                <h2 class="text-base font-semibold text-gray-900">Kategori</h2>
                <select name="categoryId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm">
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat.id %>" <%= cat.id === product.category_id ? 'selected' : '' %>><%= cat.name %></option>
                    <% }) %>
                </select>
            </div>

            <!-- Tehlikeli Alan (Silme) -->
            <div class="bg-red-50 p-5 rounded-xl border border-red-100 space-y-2">
                <h3 class="text-sm font-bold text-red-800">Ürünü Sil</h3>
                <p class="text-xs text-red-600">Bu işlem geri alınamaz. Ürün siteden ve sepetlerden kaldırılır.</p>
                <button type="button" class="w-full mt-2 px-3 py-2 bg-white border border-red-300 text-red-600 rounded-lg text-xs font-semibold hover:bg-red-50">Ürünü Tamamen Sil</button>
            </div>

        </div>

    </form>
</div>