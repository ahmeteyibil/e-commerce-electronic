<section class="container mx-auto px-4 py-8">
    <div class="flex flex-col gap-8">
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-4">Mağaza Ürünlerim</h1>
            <form id="add-product-form" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="new-product-name" class="block text-sm font-medium text-gray-700 mb-1">Ürün Adı</label>
                    <input id="new-product-name" type="text" name="name"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Ürün adı girin">
                </div>
                <div>
                    <label for="new-product-price" class="block text-sm font-medium text-gray-700 mb-1">Fiyat
                        (₺)</label>
                    <input id="new-product-price" type="number" step="0.01" name="price"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="0.00">
                </div>
                <div>
                    <label for="new-product-image-url" class="block text-sm font-medium text-gray-700 mb-1">Görsel
                        URL</label>
                    <input id="new-product-image-url" type="text" name="imgUrl"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="https://...">
                </div>

                <div>
                    <label for="new-product-category"
                        class="block text-sm font-medium text-gray-700 mb-1">Kategori</label>
                    <select id="new-product-category" name="categoryId"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <% categories.forEach(cat=> { %>
                            <option value="<%- cat.name %>" data-category-id="<%- cat.id %>"><%- cat.name %></option>
                            <% }); %>
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label for="new-product-description" class="block text-sm font-medium text-gray-700 mb-1">Ürün
                        Açıklaması</label>
                    <textarea id="new-product-description" name="description" rows="5"
                        class="w-full max-h-40 resize-y overflow-y-auto border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Ürün açıklaması girin"></textarea>
                </div>
                <div class="md:col-span-2">
                    <button id="add-product-btn" type="submit"
                        class="bg-blue-700 hover:bg-blue-900 text-white font-medium px-5 py-2.5 rounded-lg transition-all duration-200 cursor-pointer">
                        Ürün Ekle
                    </button>
                </div>
            </form>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold text-gray-800">Ürün Listesi</h2>
                <button id="refresh-products-btn" type="button"
                    class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2 rounded-lg transition-all duration-200">
                    Listeyi Yenile
                </button>
            </div>
            <% if (products && products.length> 0) { %>
                <div id="shop-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% products.forEach(product=> { %>
                        <div class="flex flex-col gap-3">
                            <%- include('../partials/product-box', { product }) %>
                                <button id="edit-product-btn-<%= product.id %>" type="button"
                                    class="edit-product-btn bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg transition-all duration-200"
                                    data-product-id="<%= product.id %>">
                                    Ürünü Düzenle
                                </button>
                        </div>
                        <% }) %>
                </div>
                <% } else { %>
                    <div id="empty-products-state"
                        class="text-center py-10 border border-dashed border-gray-300 rounded-lg">
                        <p class="text-gray-600">Henüz mağazanıza ait ürün bulunmuyor.</p>
                    </div>
                    <% } %>
        </div>
    </div>
</section>
<script>
    const addProductForm = document.getElementById("add-product-form");
    addProductForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(e.currentTarget);
        const selectedCategory = document.getElementById("new-product-category").selectedOptions[0];
        const categoryId = selectedCategory.dataset.categoryId;
        const product = {
            ...Object.fromEntries(formData.entries()),
            categoryId
        };

        const response = await fetch("/add-item-to-shop", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(product)
        });

        const data = await response.json();
        if (data.success) {
            const productInfo = data.product;
            console.log("Veritabanına eklenen ürün bilgileri: ", productInfo);
            showAlert("Mağazaya ürün ekleme işlemi başarılı. Değişiklikleri görmek için sayfayı yenileyin.", 6000);
        }
    });
</script>