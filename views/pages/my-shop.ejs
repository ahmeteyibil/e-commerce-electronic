<section class="container mx-auto px-4 py-8">
    <div class="flex flex-col gap-8">
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-4">Mağaza Ürünlerim</h1>
            <form id="add-product-form" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="new-product-name" class="block text-sm font-medium text-gray-700 mb-1">Ürün Adı</label>
                    <input id="new-product-name" type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ürün adı girin">
                </div>
                <div>
                    <label for="new-product-stock-code" class="block text-sm font-medium text-gray-700 mb-1">Stok Kodu</label>
                    <input id="new-product-stock-code" type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Stok kodu girin">
                </div>
                <div>
                    <label for="new-product-price" class="block text-sm font-medium text-gray-700 mb-1">Fiyat (₺)</label>
                    <input id="new-product-price" type="number" step="0.01" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="0.00">
                </div>
                <div>
                    <label for="new-product-image-url" class="block text-sm font-medium text-gray-700 mb-1">Görsel URL</label>
                    <input id="new-product-image-url" type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="https://...">
                </div>
                <div class="md:col-span-2">
                    <button id="add-product-btn" type="submit" class="bg-blue-700 hover:bg-blue-900 text-white font-medium px-5 py-2.5 rounded-lg transition-all duration-200">
                        Ürün Ekle
                    </button>
                </div>
            </form>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold text-gray-800">Ürün Listesi</h2>
                <button id="refresh-products-btn" type="button" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2 rounded-lg transition-all duration-200">
                    Listeyi Yenile
                </button>
            </div>
            <% if (products && products.length > 0) { %>
                <div id="shop-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% products.forEach(product => { %>
                        <div class="flex flex-col gap-3">
                            <%- include('../partials/product-box', { product }) %>
                            <button
                                id="edit-product-btn-<%= product.id %>"
                                type="button"
                                class="edit-product-btn bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg transition-all duration-200"
                                data-product-id="<%= product.id %>">
                                Ürünü Düzenle
                            </button>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div id="empty-products-state" class="text-center py-10 border border-dashed border-gray-300 rounded-lg">
                    <p class="text-gray-600">Henüz mağazanıza ait ürün bulunmuyor.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>