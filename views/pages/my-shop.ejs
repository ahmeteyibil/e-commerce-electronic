<section class="container mx-auto w-3/4 px-4 py-8">
    <div class="flex flex-col gap-8">
        <div id="shop-products-area" class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold text-gray-800">Ürün Listesi</h2>
                <button id="refresh-products-btn" type="button"
                    class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2 rounded-lg transition-all duration-200 cursor-pointer">
                    Listeyi Yenile
                </button>
            </div>
            <% if (products && products.length> 0) { %>
                <div id="shop-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-y-4 gap-x-2">
                    <% products.forEach(product=> { %>
                        <%- include('../partials/product-my-shop-box', { product }) %>
                            <% }) %>
                </div>
                <% } else { %>
                    <div id="empty-products-state"
                        class="text-center py-10 border border-dashed border-gray-300 rounded-lg">
                        <p class="text-gray-600">Henüz mağazanıza ait ürün bulunmuyor.</p>
                    </div>
                    <% } %>
        </div>
        <div id="add-new-product-area" class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-4">Ürün Ekle</h1>
            <form id="add-product-form" class="flex flex-col gap-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="input-box">
                        <label for="new-product-name" class="block text-sm font-medium text-gray-700 mb-1">Ürün
                            Adı</label>
                        <input id="new-product-name" type="text" name="productName" required
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="Ürün adı girin">
                    </div>
                    <div class="input-box">
                        <label for="new-product-price" class="block text-sm font-medium text-gray-700 mb-1">Fiyat
                            (₺)</label>
                        <input id="new-product-price" type="number" step="0.01" required name="price"
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="0.00">
                    </div>
                    <div class="input-box">
                        <label for="new-product-category"
                            class="block text-sm font-medium text-gray-700 mb-1">Kategori</label>
                        <select id="new-product-category" name="categoryId" required
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <% categories.forEach(cat=> { %>
                                <option value="<%- cat.name %>" data-category-id="<%- cat.id %>"><%- cat.name %>
                                </option>
                                <% }); %>
                        </select>
                    </div>
                </div>
                <div id="image-input-boxes" class="flex flex-col gap-y-4">
                    <div class="input-box">
                        <label for="new-product-image-url" class="block text-sm font-medium text-gray-700 mb-1">Ana
                            Görsel
                            URL</label>
                        <input id="new-product-image-url" required type="text" name="imgUrl"
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            placeholder="https://...">
                    </div>
                </div>

                <div>
                    <button type="button" id="add-additional-image-btn"
                        class="px-3 py-2 bg-cyan-600 text-white text-sm text-center cursor-pointer rounded-md">Ek görsel
                        ekle <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <div class="input-box md:col-span-2">
                    <label for="new-product-description" class="block text-sm font-medium text-gray-700 mb-1">Ürün
                        Açıklaması</label>
                    <textarea id="new-product-description" required name="description" rows="5"
                        class="w-full max-h-40 resize-y overflow-y-auto border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="Ürün açıklaması girin"></textarea>
                </div>
                <div class="md:col-span-2 flex justify-end items-center">
                    <button id="add-product-btn" type="submit"
                    class="bg-blue-700 hover:bg-blue-900 text-white font-medium px-5 py-2.5 rounded-lg transition-all duration-200 cursor-pointer">
                    Ürün Ekle
                </button>
                </div>
                
            </form>
        </div>

    </div>
</section>
<script>
    const addProductForm = document.getElementById("add-product-form");
    const refreshProductsBtn = document.getElementById("refresh-products-btn");
    const addAdditionalImageBtn = document.getElementById("add-additional-image-btn");
    const imageInputBoxes = document.getElementById("image-input-boxes");

    var additionalImageInputCount = 0;
    const maxAddImageInput = 5;

    addAdditionalImageBtn.addEventListener("click", async (e) => {
        if (additionalImageInputCount >= maxAddImageInput) {
            return;
        }
        additionalImageInputCount++;
        const newImageInputBox = document.createElement("div");
        newImageInputBox.innerHTML = `<div>
            <label for="new-product-additional-image-${additionalImageInputCount}" class="input-box block text-sm font-medium text-gray-700 mb-1">Ek Görsel ${additionalImageInputCount} URL</label>
            <input id="new-product-additional-image-${additionalImageInputCount}" type="text" name="additionalImgUrl"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="https://...">
        </div>`;
        imageInputBoxes.appendChild(newImageInputBox);
        if (additionalImageInputCount >= maxAddImageInput) {
            // button becomes invisible
            addAdditionalImageBtn.classList.toggle('insivible', true);
            addAdditionalImageBtn.classList.toggle('hidden', true);
            addAdditionalImageBtn.disabled = true;
        }
    })

    refreshProductsBtn.addEventListener("click", async (e) => {


        // const response = await fetch('/get-my-products', {
        //     method: "GET",
        //     headers: {
        //         "Content-Type": "application/json"
        //     },

        // })
    });

    addProductForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(e.currentTarget);
        const selectedCategory = document.getElementById("new-product-category").selectedOptions[0];
        const categoryId = selectedCategory.dataset.categoryId;

        const additionalImgUrls = formData.getAll("additionalImgUrl")
            .map(url => url.trim())
            .filter(url => url !== "");

        const formObject = Object.fromEntries(formData.entries());

        delete formObject.additionalImgUrl;

        const product = {
            ...formObject,
            categoryId,
            additionalImgUrls
        };

        console.log("API'ye gönderilecek ürün bilgileri: ", product);

        const response = await fetch("/add-item-to-shop", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(product)
        });

        const data = await response.json();

        console.log("API'den gelen json data: ", data);

        if (data.success) {
            const productInfo = data.product;
            console.log("Veritabanına eklenen ürün bilgileri: ", productInfo);
            showAlert("Mağazaya ürün ekleme işlemi başarılı. Değişiklikleri görmek için sayfayı yenileyin.", 6000);
        }
        else {
            console.log("Ürün eklenemedi");
        }
    });
</script>