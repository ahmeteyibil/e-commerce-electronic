<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ahmet Elektronik | <%= title %>
    </title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
        integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body
    class="relative w-full h-screen bg-linear-to-r from-blue-500 via-purple-500 to-pink-500 flex items-center justify-center">
    <div id="state-box"
        class="absolute p-4 bg-green-600 text-black shadow-lg font-bold -top-14 left-0 right-0 w-3/4 mx-auto rounded-md transition-all ease-in-out duration-100">
        <span id="state-text" class="">sadasd</span>
    </div>
    <div
        class="login-box bg-[#0B0521] text-white p-16 rounded-2xl border border-black border-solid flex flex-col gap-y-8 items-center justify-center">
        <h1 class="text-3xl font-bold">Satıcı hesabı oluştur</h1>
        <form action="/become-a-seller" method="post" class="flex flex-col gap-y-4">
            <div
                class="input-box flex items-center justify-between h-12 px-4 gap-x-2 border border-solid border-white rounded-lg">
                <i class="fa-solid fa-address-card"></i>
                <input class="flex-1 h-full outline-none" id="shop-name" type="text" name="shop-name"
                    placeholder="Shop name">
            </div>
            <div
                class="input-box flex items-center justify-between h-12 px-4 gap-x-2 border border-solid border-white rounded-lg">
                <i class="fa-solid fa-envelope"></i>
                <input class="flex-1 h-full outline-none" id="slug-input" type="text" name="shop-slug"
                    placeholder="Shop slug (url)">
            </div>
            <div
                class="input-box flex items-center justify-between h-12 px-4 gap-x-2 border border-solid border-white rounded-lg">
                <i class="fa-solid fa-envelope"></i>
                <input class="flex-1 h-full outline-none" id="iban-input" type="text" name="shop-iban"
                    placeholder="IBAN">
            </div>
            <button
                class="submit-button px-4 py-2 rounded-lg border border-solid border-black bg-blue-700 transition-all duration-300 hover:bg-blue-900 cursor-pointer"
                type="submit">Hesabı oluştur</button>
        </form>
        <a href="/">Ana sayfaya dön</a>
    </div>
</body>

</html>
<script>
    const stateBox = document.getElementById("state-box");

    const pushStateBox = (success, message) => {
        stateBox.classList.remove("invisible");
        stateBox.classList.remove("-top-14");
        stateBox.classList.add("top-4");

        if (success) {
            stateBox.classList.remove("bg-red-600");
            stateBox.classList.add("bg-green-600");
        }
        else {
            stateBox.classList.remove("bg-green-600");
            stateBox.classList.add("bg-red-600");
        }
        stateText.textContent = message;
        setTimeout(() => {
            stateBox.classList.add("invisible");
            stateBox.classList.remove("top-4");
            stateBox.classList.add("-top-14");
        }, 2000);
    }
    const shopNameInput = document.getElementById("shop-name");
    const slugInput = document.getElementById("slug-input");
    const ibanInput = document.getElementById("iban-input");

    const submitButton = document.querySelector(".submit-button");
    submitButton.addEventListener('click', async (e) => {
        try {
            const shopName = shopNameInput?.value.trim();
            const slug = slugInput?.value.trim();
            const iban = ibanInput?.value.trim();
            
            console.log(`Input'lardan çekilen bilgiler:\nShop Name: ${shopName},\nShop Slug: ${slug},\nShop IBAN: ${iban},`);
            const response = await fetch('/become-a-seller', {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ shopName, slug, iban })
            })
            let data = await response.json();
            pushStateBox(data.success, data.message);
            if (data.success) {
                setTimeout(() => {
                    window.location.href = "/";
                }, 1000);
            }

        } catch (er) {
            console.log("become-a-seller API'sine Post isteği gönderilirken hata oluştu: ", er.message);
        }

    });
</script>